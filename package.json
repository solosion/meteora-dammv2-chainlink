{
  "name": "dlmm-buywall-tracker",
  "version": "2.0.0",
  "description": "Detects large single-sided DLMM positions (buy walls) on Meteora and sends Telegram alerts with signal scoring",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "test": "jest --forceExit --detectOpenHandles",
    "simulate": "ts-node --transpile-only src/simulate-buywall.ts",
    "go": "npm run build && npm start"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.10",
    "@solana/web3.js": "^1.95.3",
    "dotenv": "^16.4.5",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
