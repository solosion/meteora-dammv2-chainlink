# === Solana ===
# Helius RPC URL (z.B. https://mainnet.helius-rpc.com/?api-key=DEIN_KEY)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Wallet Seed Phrase (12 oder 24 Wörter)
SOLANA_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# === Telegram ===
# Bot Token von @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# Chat ID des Alert-Channels (von dem die Alerts kommen)
TELEGRAM_ALERT_CHAT_ID=-1001234567890

# Deine persönliche Chat ID (für Status-Nachrichten)
TELEGRAM_ADMIN_CHAT_ID=123456789

# === Risk Management ===
# Max SOL pro einzelne Position
MAX_POSITION_SIZE_SOL=0.5

# Max Gesamtexposure in SOL
MAX_TOTAL_EXPOSURE_SOL=5.0

# Stop-Loss in Prozent (z.B. 20 = 20% Verlust)
STOP_LOSS_PERCENT=20

# Take-Profit in Prozent (z.B. 50 = 50% Gewinn)
TAKE_PROFIT_PERCENT=50

# Max Anzahl gleichzeitiger Positionen
MAX_OPEN_POSITIONS=10

# === Alert Parser ===
# Regex-Pattern um Token Mint Adressen aus Alerts zu extrahieren
# Standard: Erkennt Solana Adressen (Base58, 32-44 Zeichen)
ALERT_TOKEN_REGEX=[1-9A-HJ-NP-Za-km-z]{32,44}

# Nur Alerts von bestimmten Usern/Bots verarbeiten (kommagetrennt, leer = alle)
ALERT_ALLOWED_SENDERS=

# === Price Feeds ===
# Binance WebSocket: Symbole kommagetrennt (Standard: solusdt)
BINANCE_SYMBOLS=solusdt,btcusdt

# Binance WebSocket URL (Standard: wss://stream.binance.com:9443)
# Für US-Server: wss://stream.binance.us:9443
BINANCE_WS_URL=wss://stream.binance.com:9443

# Proxy für Binance WebSocket (bei Geo-Blocking)
# Formate: socks5://host:port, socks5://user:pass@host:port, http://host:port
PROXY_URL=

# Polymarket: Market Slugs kommagetrennt (leer = deaktiviert)
# Beispiel: will-bitcoin-hit-100k-in-2025,will-solana-hit-500
POLYMARKET_MARKETS=

# Polymarket Abfrage-Intervall in Sekunden (Standard: 30)
POLYMARKET_INTERVAL_SECONDS=30

# === Sonstiges ===
# Position Monitor Intervall in Sekunden
MONITOR_INTERVAL_SECONDS=30

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
