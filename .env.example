# === Solana RPC ===
# Helius RPC URL (z.B. https://mainnet.helius-rpc.com/?api-key=DEIN_KEY)
# Wichtig: WebSocket-fähiger RPC nötig (Helius, Quicknode, Triton etc.)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# === Telegram ===
# Bot Token von @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# Deine persönliche Chat ID (von @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# === DLMM Buy Wall Tracker ===
# Erkennt große einseitige SOL-Positionen auf Meteora DLMM Pools
DLMM_BUYWALL_ENABLED=true

# Min SOL-Wert für Buy Wall Erkennung
DLMM_BUYWALL_MIN_SOL=50

# Richtung: below (Kaufwand/Support), above (Verkaufswand/Resistance), either (beides)
DLMM_BUYWALL_DIRECTION=below

# Min Anteil SOL an der Position (0.0 - 1.0, Standard 0.95 = 95% einseitig)
DLMM_BUYWALL_SINGLE_SIDE_THRESHOLD=0.95

# === Web Dashboard ===
# Live-Dashboard mit allen erkannten Walls, Charts und Listener-Status
# Aufruf im Browser: http://SERVER_IP:3000
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# Optional: Zugriffsschutz. Wenn gesetzt, Dashboard mit http://SERVER_IP:3000/?token=DEIN_TOKEN aufrufen
DASHBOARD_AUTH_TOKEN=

# === Sonstiges ===
# Log Level (debug, info, warn, error)
LOG_LEVEL=info
