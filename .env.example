# === Solana ===
# Helius RPC URL (z.B. https://mainnet.helius-rpc.com/?api-key=DEIN_KEY)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Wallet Seed Phrase (12 oder 24 Wörter)
SOLANA_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# === Telegram ===
# Bot Token von @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# Deine persönliche Chat ID (für Status-Nachrichten)
TELEGRAM_ADMIN_CHAT_ID=123456789

# === Risk Management ===
# Max SOL pro einzelne Position
MAX_POSITION_SIZE_SOL=0.5

# Max Gesamtexposure in SOL
MAX_TOTAL_EXPOSURE_SOL=5.0

# Max Anzahl gleichzeitiger Positionen
MAX_OPEN_POSITIONS=10

# Max Market Cap in USD (nur Tokens unter diesem Wert werden berücksichtigt)
# Standard: 1.000.000 USD (1M)
MAX_MARKET_CAP_USD=1000000

# Min Liquidität in USD (Tokens mit weniger Liquidität werden übersprungen)
# Standard: 5.000 USD
MIN_LIQUIDITY_USD=5000

# === On-Chain Pool Watcher ===
# Überwacht neue DAMM v2 Pools direkt auf der Blockchain
POOL_WATCHER_ENABLED=true

# Poll-Intervall in Sekunden (wie oft nach neuen Pools gesucht wird)
POOL_WATCHER_INTERVAL_SECONDS=5

# Nur Tokens mit diesen Suffixen im Symbol/Name erlauben (kommagetrennt)
# Standard: pump,bonk — leer = alle Tokens erlaubt
ALLOWED_TOKEN_SUFFIXES=pump,bonk

# === DLMM Buy Wall Tracker ===
# Erkennt große einseitige SOL-Positionen auf Meteora DLMM Pools
DLMM_BUYWALL_ENABLED=false

# Min SOL-Wert für Buy Wall Erkennung
DLMM_BUYWALL_MIN_SOL=50

# Richtung: below (Kaufwand/Support), above (Verkaufswand/Resistance), either (beides)
DLMM_BUYWALL_DIRECTION=below

# Min Anteil SOL an der Position (0.0 - 1.0, Standard 0.95 = 95% einseitig)
DLMM_BUYWALL_SINGLE_SIDE_THRESHOLD=0.95

# === Web Dashboard ===
# Live-Dashboard mit allen erkannten Walls, Charts und Listener-Status
# Aufruf im Browser: http://SERVER_IP:3000
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# Optional: Zugriffsschutz. Wenn gesetzt, Dashboard mit http://SERVER_IP:3000/?token=DEIN_TOKEN aufrufen
DASHBOARD_AUTH_TOKEN=

# === Sonstiges ===
# Position Monitor Intervall in Sekunden
MONITOR_INTERVAL_SECONDS=30

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
